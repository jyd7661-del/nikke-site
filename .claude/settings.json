{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/checkData.mjs)",
      "Bash(node scripts/testI18n.mjs)",
      "Bash(node scripts/testCharacterNames.mjs)",
      "Bash(node scripts/testGlossary.mjs)",
      "Bash(node scripts/findTotems.mjs)",
      "Bash(npm run verify)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./nikke-site/.env)",
      "Read(./nikke-site/.env.*)"
    ]
  }
}
